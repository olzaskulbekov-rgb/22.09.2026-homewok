print("Счетчик Б: ", counter_b())

# Задание 5
def make_wallet(start_balance):
    balance = start_balance
    def buy(price):
        nonlocal balance
        if balance >= price:
            balance -= price
            return balance
        else:
            return -1
    return buy
ekeb_wallet = make_wallet(2000)
trip_wallet = make_wallet(500)
empty_wallet = make_wallet(0)

print("Осталось на балансе: ", empty_wallet(0))
