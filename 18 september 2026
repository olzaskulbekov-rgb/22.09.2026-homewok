# Задание 4
def make_counter():
    count = 0
    def next_check():
        nonlocal count
        count += 1
        return count
    return next_check
counter_a = make_counter()
counter_b = make_counter()
print("Счетчик А: ", counter_a())
print("Счетчик А: ", counter_a())
print("Счетчик Б: ", counter_b())
