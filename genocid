# 1. Функция-тестировщик
def check_case(function, value, expected):
    actual = function(value)
    return actual == expected


# Функция, которую нужно проверить (из условия)
def ekeb_price(price):
    if price >= 1000:
        return price - 100
    return price


# Ошибочная функция (из условия)
def wrong_price(price):
    return price - 100


# Функция из задания 3 (для проверки)
def make_discount(amount):
    def discount(price):
        result = price - amount
        if result < 0:
            return 0
        return result

    return discount


discount_100 = make_discount(100)


# --- ПРОВЕРКИ ---

# 1. Тесты для ekeb_price (все True)
print(check_case(ekeb_price, 999, 999))  # True
print(check_case(ekeb_price, 1000, 900))  # True
print(check_case(ekeb_price, 1001, 901))  # True

# 2. Тесты для wrong_price (False, True, True)
print(check_case(wrong_price, 999, 999))  # False
print(check_case(wrong_price, 1000, 900))  # True
print(check_case(wrong_price, 1001, 901))  # True

# 3. Дополнительные проверки из задания
print(check_case(ekeb_price, 0, 0))  # True (цена 0)
print(check_case(discount_100, 250, 150))  # True (discount_100 из 3-го задания)






