def calculate_price(price, quantity):
    total = price * quantity


    if total >= 15000:
        discount = 20
    elif total >= 10000:
        discount = 15
    elif total >= 5000:
        discount = 10
    else:
        discount = 0

    final_price = total * (1 - discount / 100)
    return final_price, discount



price_input = float(input("Введите цену товара: "))
quantity_input = int(input("Введите количество товара: "))


final_sum, applied_discount = calculate_price(price_input, quantity_input)


print(f"\nПримененная скидка: {applied_discount}%")
print(f"Итоговая сумма к оплате: {final_sum:.2f}")


#задание 2


def calculate_discount(total_sum):
    if total_sum >= 15000:
        return 20
    elif total_sum >= 10000:
        return 15
    elif total_sum >= 5000:
        return 10
    else:
        return 0


total_order_sum = 0


for i in range(1, 4):
    print(f"--- Товар {i} ---")
    price = float(input("Введите цену товара: "))
    quantity = int(input("Введите количество: "))
    total_order_sum += price * quantity
    print()


discount_percent = calculate_discount(total_order_sum)
discount_amount = total_order_sum * (discount_percent / 100)
final_price = total_order_sum - discount_amount


print("=" * 30)
print(f"Сумма заказа без скидки: {total_order_sum:.2f}")
print(f"Размер скидки ({discount_percent}%): {discount_amount:.2f}")
print(f"Итог к оплате: {final_price:.2f}")

