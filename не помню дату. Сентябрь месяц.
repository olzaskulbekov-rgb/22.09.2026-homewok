# Задание 6
# Цена со скидкой
def calculate_distance(price, discount=0):
    return price * (1 - discount / 100)
print(calculate_distance(1000,15))
print(calculate_distance(5000,25))

# Задание 7
# Простой калькулятор
def add(a, b):
    return a + b
def subtract(a, b):
    return a - b
def multiply(a, b):
    return a * b
def divide(a, b):
    if b == 0:
        return "На ноль делить нельзя"
    else:
        return a / b
print("Сумма:", add(2,10))
print("Разность: ", subtract(2,2))
print("Произведение: ", multiply(2,2))
print("Деление: ", divide(0,5))

# Задание 8
# Задание со звездочкой
def is_palindrome(text):
    text = text.lower()
    return text == text[::-1]
print("Слово палидром? ", is_palindrome("топот"))
print("Слово палидром? ", is_palindrome("python"))

